{
  "name": "@uzolabs/sdk",
  "version": "0.0.0",
  "description": "Typed, viem-native toolkit for building on BOT Chain.",
  "license": "MIT",
  "author": "Uzo Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uzolabs/uzo-sdk.git"
  },
  "homepage": "https://github.com/uzolabs/uzo-sdk#readme",
  "bugs": {
    "url": "https://github.com/uzolabs/uzo-sdk/issues"
  },
  "keywords": [
    "bot-chain",
    "botchain",
    "viem",
    "evm",
    "web3",
    "sdk",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./chains": {
      "import": {
        "types": "./dist/chains/index.d.ts",
        "default": "./dist/chains/index.js"
      },
      "require": {
        "types": "./dist/chains/index.d.cts",
        "default": "./dist/chains/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "chains": [
        "./dist/chains/index.d.cts"
      ]
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "size": "size-limit",
    "check:exports": "publint && attw --pack . --profile node16",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@size-limit/preset-small-lib": "^14.1.0",
    "@types/node": "^26.6.3",
    "publint": "^0.3.24",
    "size-limit": "^14.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "viem": "^2.57.1",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
